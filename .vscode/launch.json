{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Windows) Launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/nevermore-fms.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "NEVERMORE_LOG",
                    "value": "trace"
                },
                {
                    "name": "NEVERMORE_DATA_DIR",
                    "value": "./data"
                },
                {
                    "name": "NEVERMORE_WEB_TLS",
                    "value": "true"
                },
                {
                    "name": "NEVERMORE_WEB_HOSTNAME",
                    "value": "fms.nevermore:8000"
                }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "cargo build"
        }
    ]
}